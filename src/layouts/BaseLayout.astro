---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: object;
}

const { title, description, canonical, schema } = Astro.props;
const siteTitle = title ? `${title} | Sales Tax Questions` : 'Sales Tax Questions';
const canonicalURL = canonical ? `https://salestaxquestions.com${canonical}` : Astro.url.href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{siteTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={siteTitle} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="article" />
  <meta name="robots" content="index, follow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "TaxCloud",
    "url": "https://taxcloud.com",
    "description": "TaxCloud is a Certified Service Provider (CSP) in the Streamlined Sales Tax program, providing sales tax compliance for mid-market ecommerce brands across all 50 US states and Canada.",
    "sameAs": ["https://salestaxquestions.com"]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Sales Tax Questions",
    "url": "https://salestaxquestions.com",
    "description": "Plain-language answers to U.S. sales tax questions for ecommerce businesses.",
    "publisher": {
      "@type": "Organization",
      "name": "TaxCloud",
      "url": "https://taxcloud.com"
    }
  })} />
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
  <slot name="head" />
</head>
<body class="bg-white text-gray-900 font-sans antialiased">
  <header class="border-b border-gray-100 bg-white/95 backdrop-blur-sm sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-4 py-3.5 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 group">
        <span class="flex items-center justify-center w-7 h-7 rounded-md bg-green-600">
          <svg viewBox="0 0 14 17" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-4">
            <path d="M1.5 0h7L13 4.5V15.5a1 1 0 01-1 1h-10a1 1 0 01-1-1V1a1 1 0 011-1z" fill="white"/>
            <path d="M8.5 0L13 4.5H9.5a1 1 0 01-1-1V0z" fill="rgba(0,60,0,0.15)"/>
            <rect x="3" y="7" width="7" height="1.1" rx="0.55" fill="#16a34a"/>
            <rect x="3" y="9.6" width="7" height="1.1" rx="0.55" fill="#16a34a"/>
            <rect x="3" y="12.2" width="4.5" height="1.1" rx="0.55" fill="#16a34a"/>
          </svg>
        </span>
        <span class="font-semibold text-slate-900 text-sm tracking-tight group-hover:text-green-700 transition-colors" style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;">Sales Tax Questions</span>
      </a>
      <nav class="flex items-center gap-1">
        <a href="/topics" class="px-3 py-1.5 text-sm text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-md transition-colors">Topics</a>
        <a href="/compare" class="px-3 py-1.5 text-sm text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-md transition-colors">Compare</a>
        <a href="/states" class="px-3 py-1.5 text-sm text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-md transition-colors">States</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="border-t border-gray-100 mt-20 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 py-10">
      <div class="flex flex-col md:flex-row justify-between gap-8 text-sm text-gray-500">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="flex items-center justify-center w-6 h-6 rounded bg-green-600">
              <svg viewBox="0 0 14 17" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-3 h-3.5">
                <path d="M1.5 0h7L13 4.5V15.5a1 1 0 01-1 1h-10a1 1 0 01-1-1V1a1 1 0 011-1z" fill="white"/>
                <path d="M8.5 0L13 4.5H9.5a1 1 0 01-1-1V0z" fill="rgba(0,60,0,0.15)"/>
                <rect x="3" y="7" width="7" height="1.1" rx="0.55" fill="#16a34a"/>
                <rect x="3" y="9.6" width="7" height="1.1" rx="0.55" fill="#16a34a"/>
                <rect x="3" y="12.2" width="4.5" height="1.1" rx="0.55" fill="#16a34a"/>
              </svg>
            </span>
            <span class="font-semibold text-gray-800 text-sm" style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;">Sales Tax Questions</span>
          </div>
          <p class="text-gray-400 text-xs leading-relaxed max-w-xs">Plain-language answers for ecommerce businesses navigating U.S. sales tax compliance.</p>
        </div>
        <div class="flex gap-10">
          <div>
            <p class="font-medium text-gray-700 mb-3 text-xs uppercase tracking-wider">Topics</p>
            <ul class="space-y-2">
              <li><a href="/topics/economic-nexus" class="hover:text-green-700 transition-colors">Economic Nexus</a></li>
              <li><a href="/topics/physical-nexus" class="hover:text-green-700 transition-colors">Physical Nexus</a></li>
              <li><a href="/topics/sst-program" class="hover:text-green-700 transition-colors">SST Program</a></li>
              <li><a href="/topics/registration" class="hover:text-green-700 transition-colors">Registration</a></li>
            </ul>
          </div>
          <div>
            <p class="font-medium text-gray-700 mb-3 text-xs uppercase tracking-wider">More</p>
            <ul class="space-y-2">
              <li><a href="/compare" class="hover:text-green-700 transition-colors">Compare</a></li>
              <li><a href="/states" class="hover:text-green-700 transition-colors">States</a></li>
              <li><a href="/topics" class="hover:text-green-700 transition-colors">All Topics</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="mt-8 pt-6 border-t border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <p class="text-xs text-gray-400">This content is for informational purposes only and does not constitute legal or tax advice. Consult a qualified tax professional for advice specific to your situation.</p>
        <p class="text-xs text-gray-400 shrink-0">Published by <a href="https://taxcloud.com" class="text-green-700 hover:underline" target="_blank" rel="noopener">TaxCloud</a></p>
      </div>
    </div>
  </footer>
  <Analytics />
</body>
</html>
